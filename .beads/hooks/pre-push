#!/usr/bin/env sh
# beads' pre-push, then publish the beads database. HARD FAIL if it cannot.
# refs/dolt/data is a non-branch ref that `git push` does not carry, and the tracked
# JSONL was retired — so this push is the only thing that gets beads off this host.
root="$(git rev-parse --show-toplevel)"
if [ -x "$root/.beads/hooks/pre-push" ]; then
  "$root/.beads/hooks/pre-push" "$@" || exit $?
fi
command -v bd >/dev/null 2>&1 || exit 0
[ -d "$root/.beads" ] || exit 0
grep -q '^sync\.remote:' "$root/.beads/config.yaml" 2>/dev/null || exit 0
cd "$root" || exit 1
out="$(bd dolt push 2>&1)" || {
  printf '\n  BEADS DOLT PUSH FAILED — refusing the git push\n%s\n' "$out" >&2
  printf '  Your beads are NOT published; the JSONL no longer backs this up.\n\n' >&2
  exit 1
}
echo "beads: dolt push ok"
